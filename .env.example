# OpenAI-compatible 主对话模型服务的 API Key
OPENAI_API_KEY=your_main_model_api_key_here

# OpenAI-compatible 主对话模型服务的基础地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 主对话模型名称
OPENAI_MODEL=gpt-4o-mini

# agent 允许工作的工作区根目录
WORKSPACE_ROOT=.

# 长期记忆使用的 embedding 模型名称
# 如果你走阿里云百炼兼容接口，可填 text-embedding-v3 或 text-embedding-v4
EMBEDDING_MODEL=text-embedding-v3

# embedding 服务专用 API Key
# 如果留空，代码会默认回退到 OPENAI_API_KEY
EMBEDDING_API_KEY=

# embedding 服务专用基础地址
# 阿里云百炼兼容接口示例：
# https://dashscope.aliyuncs.com/compatible-mode/v1
# 如果留空，代码会默认回退到 OPENAI_BASE_URL
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# embedding 向量维度
# 设为 0 表示不显式传 dimensions
# 百炼的 text-embedding-v3 / text-embedding-v4 可按需要配置 1024 等维度
EMBEDDING_DIMENSIONS=1024

# 是否启用 Qdrant 服务端向量索引
QDRANT_ENABLED=false

# Qdrant 服务地址
QDRANT_URL=http://localhost:6333

# Qdrant API Key，本地无鉴权时可留空
QDRANT_API_KEY=

# Qdrant 中用于存放项目长期记忆的集合名
QDRANT_COLLECTION=project_memories

# 主聊天模型重试次数
MODEL_RETRY_MAX_ATTEMPTS=3

# 主聊天模型首次重试等待秒数
MODEL_RETRY_BASE_DELAY_SECONDS=0.8

# 主聊天模型重试退避倍数
MODEL_RETRY_BACKOFF_MULTIPLIER=2.0

# 主聊天模型单次等待上限秒数
MODEL_RETRY_MAX_DELAY_SECONDS=4.0

# 主聊天模型连续失败多少次后熔断
MODEL_CIRCUIT_FAILURE_THRESHOLD=3

# 主聊天模型熔断冷却秒数
MODEL_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30

# 辅助模型重试次数
# 这组配置会用于长期记忆 reflection / verifier / 旧历史摘要
AUX_MODEL_RETRY_MAX_ATTEMPTS=3

# 辅助模型首次重试等待秒数
AUX_MODEL_RETRY_BASE_DELAY_SECONDS=0.8

# 辅助模型重试退避倍数
AUX_MODEL_RETRY_BACKOFF_MULTIPLIER=2.0

# 辅助模型单次等待上限秒数
AUX_MODEL_RETRY_MAX_DELAY_SECONDS=4.0

# 辅助模型连续失败多少次后熔断
AUX_MODEL_CIRCUIT_FAILURE_THRESHOLD=3

# 辅助模型熔断冷却秒数
AUX_MODEL_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=45

# 向量链路重试次数
# 这组配置会用于 embedding 与 Qdrant 请求
VECTOR_RETRY_MAX_ATTEMPTS=3

# 向量链路首次重试等待秒数
VECTOR_RETRY_BASE_DELAY_SECONDS=0.8

# 向量链路重试退避倍数
VECTOR_RETRY_BACKOFF_MULTIPLIER=2.0

# 向量链路单次等待上限秒数
VECTOR_RETRY_MAX_DELAY_SECONDS=4.0

# 向量链路连续失败多少次后熔断
VECTOR_CIRCUIT_FAILURE_THRESHOLD=3

# 向量链路熔断冷却秒数
VECTOR_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=45

# decay：当 active project 记忆数量达到这个阈值并命中整数倍时，允许触发一次全量刷新
DECAY_FULL_SCAN_TRIGGER_COUNT=50

# decay 分数下限，避免分数完全掉到 0
DECAY_MIN_SCORE=0.05

# decay 分数低于这个阈值时，记忆开始具备“可归档”资格
DECAY_ARCHIVE_THRESHOLD=0.10

# 记忆至少老化到这么多天后，才允许被 decay 归档
DECAY_ARCHIVE_AGE_DAYS=60

# confidence 高于这个阈值的记忆，默认不被 decay 归档
DECAY_ARCHIVE_CONFIDENCE_THRESHOLD=0.75

# usage_count 高于这个阈值的记忆，默认不被 decay 归档
DECAY_ARCHIVE_USAGE_THRESHOLD=1

# 是否启用 decay 摘要日志
DECAY_LOG_ENABLED=true

# decay 日志是否同步打印到控制台，false 表示只写 debug.log
DECAY_LOG_ECHO=false
