# OpenAI-compatible 主对话模型服务的 API Key
OPENAI_API_KEY=your_main_model_api_key_here

# OpenAI-compatible 主对话模型服务的基础地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 主对话模型名称
OPENAI_MODEL=gpt-4o-mini

# agent 允许工作的工作区根目录
WORKSPACE_ROOT=.

# 长期记忆使用的 embedding 模型名称
# 如果你走阿里云百炼兼容接口，可填写 text-embedding-v3 或 text-embedding-v4
EMBEDDING_MODEL=text-embedding-v3

# embedding 服务专用 API Key
# 如果留空，代码会默认回退到 OPENAI_API_KEY
EMBEDDING_API_KEY=

# embedding 服务专用基础地址
# 阿里云百炼兼容接口示例：
# https://dashscope.aliyuncs.com/compatible-mode/v1
# 如果留空，代码会默认回退到 OPENAI_BASE_URL
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# embedding 向量维度
# 设为 0 表示不显式传 dimensions
# 百炼的 text-embedding-v3 / text-embedding-v4 可按需要配置 1024 等维度
EMBEDDING_DIMENSIONS=1024

# 是否启用 Qdrant 服务端向量索引
QDRANT_ENABLED=false

# Qdrant 服务地址
QDRANT_URL=http://localhost:6333

# Qdrant API Key，本地无鉴权时可留空
QDRANT_API_KEY=

# Qdrant 中用于存放项目长期记忆的集合名
QDRANT_COLLECTION=project_memories
