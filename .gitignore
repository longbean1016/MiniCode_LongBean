*.py[cod]
*$py.class
*.so

# 打包 / 构建产物
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# =========================
# 虚拟环境
# =========================
.venv/
venv/
env/
ENV/

# =========================
# 环境变量 / 密钥文件
# =========================
.env
.env.*
!.env.example

# =========================
# 测试 / 覆盖率缓存
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# =========================
# 类型检查 / Lint 缓存
# =========================
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.hypothesis/

# =========================
# 日志 / 运行时文件
# =========================
*.log
logs/
*.pid
*.out
*.err

# =========================
# 临时文件
# =========================
tmp/
temp/
*.tmp
*.temp
*.bak

# =========================
# 会话 / 转录 / 本地运行状态
# =========================
sessions/
transcripts/
runtime/
workspace_state/
.cache/
.memory

# =========================
# IDE / 编辑器配置
# =========================
.vscode/
.idea/
*.swp
*.swo
*~

# =========================
# 操作系统生成的文件
# =========================
.DS_Store
Thumbs.db

# =========================
